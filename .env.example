# OS Service — orquestrador da Saga
PORT=3000
NODE_ENV=development
SERVICE_NAME=fiap-tc-ms-os
LOG_LEVEL=debug

# Banco próprio (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=fiap_tc_os

# Mensageria
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10
SAGA_MAX_TENTATIVAS=3

# Autenticação: true sobe sem Cognito (apenas desenvolvimento e testes)
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Observabilidade (sem a licença o agente não é carregado)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=fiap-tc-ms-os-local
